{
  "name": "leanlog",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --filter @leanlog/web dev",
    "dev:web": "pnpm --filter @leanlog/web dev",
    "dev:ui": "pnpm --filter @leanlog/ui dev",
    "storybook": "pnpm --filter @leanlog/ui storybook",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:evals": "pnpm --filter @leanlog/nutrition-evals test:evals",
    "test:watch": "pnpm -r test:watch",
    "test:coverage": "pnpm -r test:coverage",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint:ox": "oxlint",
    "prepare": "husky",
    "design:audit": "node scripts/design-system-audit.mjs",
    "dev:vite": "pnpm --filter @leanlog/web dev:vite",
    "dev:api": "pnpm --filter @leanlog/web dev:api",
    "dev:db:migrate": "pnpm --filter @leanlog/web dev:db:migrate",
    "dev:db:reset": "pnpm --filter @leanlog/web dev:db:reset",
    "dev:reset": "pnpm --filter @leanlog/web dev:reset",
    "react-lint": "react-doctor --yes --verbose --diff",
    "react-lint:ci": "react-doctor --yes --blocking warning"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^4.0.18",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "react-doctor": "0.5.0",
    "vitest": "^4.1.0"
  },
  "lint-staged": {
    "*": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  }
}
